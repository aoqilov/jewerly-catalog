# Backend API manzili, /api/v1 bilan. Hujjat: https://birid.silently.watch/api/v1/docs/
VITE_API_URL=https://birid.silently.watch/api/v1

# Sayt qaysi do'konniki: mahsulot, kategoriya va yangilik so'rovlari shu do'kon bilan filtrlanadi (4 — "Jewerly")
VITE_STORE_ID=4

# true bo'lsa, so'rovlar backend'ga yuborilmaydi, api/routes/*.mockdata.ts ishlatiladi
VITE_USE_MOCK=false
